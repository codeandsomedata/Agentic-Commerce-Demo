rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'somdatta46@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    function isValidDietaryTags(tags) {
      return tags is list &&
        tags.size() <= 10 &&
        (tags.size() == 0 || (tags[0] is string && tags[0].size() > 0 && tags[0].size() <= 40));
    }

    function isValidProduct(data) {
      return data.keys().hasAll([
          'id', 'name', 'brand', 'category', 'description',
          'unit_size', 'gtin', 'dietary_tags', 'ownerId', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'name', 'brand', 'category', 'description',
          'unit_size', 'gtin', 'dietary_tags', 'ownerId', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 160 &&
        data.brand is string && data.brand.size() > 0 && data.brand.size() <= 80 &&
        data.category is string && data.category.size() > 0 && data.category.size() <= 80 &&
        data.description is string && data.description.size() > 0 && data.description.size() <= 500 &&
        data.unit_size is string && data.unit_size.size() > 0 && data.unit_size.size() <= 40 &&
        data.gtin is string && data.gtin.size() >= 8 && data.gtin.size() <= 32 &&
        isValidDietaryTags(data.dietary_tags) &&
        data.ownerId is string && data.ownerId.size() > 0 && data.ownerId.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMerchantControls(controls) {
      return controls is map &&
        controls.keys().hasAll([
          'agent_checkout_allowed', 'max_quantity_per_order',
          'requires_confirmation', 'fulfillment_methods'
        ]) &&
        controls.keys().hasOnly([
          'agent_checkout_allowed', 'max_quantity_per_order',
          'requires_confirmation', 'fulfillment_methods'
        ]) &&
        controls.agent_checkout_allowed is bool &&
        controls.max_quantity_per_order is int &&
        controls.max_quantity_per_order >= 1 &&
        controls.max_quantity_per_order <= 50 &&
        controls.requires_confirmation is bool &&
        controls.fulfillment_methods is list &&
        controls.fulfillment_methods.size() >= 1 &&
        controls.fulfillment_methods.size() <= 5 &&
        controls.fulfillment_methods[0] is string &&
        controls.fulfillment_methods[0].size() > 0 &&
        controls.fulfillment_methods[0].size() <= 40;
    }

    function isValidOffer(data) {
      return data.keys().hasAll([
          'id', 'productId', 'merchant_id', 'merchant_name', 'location',
          'price', 'currency', 'availability_status', 'stock_count',
          'merchant_controls', 'ownerId', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'productId', 'merchant_id', 'merchant_name', 'location',
          'price', 'currency', 'availability_status', 'stock_count',
          'merchant_controls', 'ownerId', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.productId) &&
        isValidId(data.merchant_id) &&
        data.merchant_name is string && data.merchant_name.size() > 0 && data.merchant_name.size() <= 100 &&
        data.location is string && data.location.size() > 0 && data.location.size() <= 100 &&
        (data.price is int || data.price is float) && data.price > 0 && data.price <= 10000 &&
        data.currency == 'USD' &&
        data.availability_status in ['in_stock', 'low_stock', 'out_of_stock'] &&
        data.stock_count is int && data.stock_count >= 0 && data.stock_count <= 100000 &&
        isValidMerchantControls(data.merchant_controls) &&
        data.ownerId is string && data.ownerId.size() > 0 && data.ownerId.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidReservation(data) {
      return data.keys().hasAll([
          'id', 'userId', 'productId', 'offerId', 'productName',
          'merchantName', 'location', 'price', 'quantity', 'status',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'userId', 'productId', 'offerId', 'productName',
          'merchantName', 'location', 'price', 'quantity', 'status',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
        isValidId(data.productId) &&
        isValidId(data.offerId) &&
        data.productName is string && data.productName.size() > 0 && data.productName.size() <= 160 &&
        data.merchantName is string && data.merchantName.size() > 0 && data.merchantName.size() <= 100 &&
        data.location is string && data.location.size() > 0 && data.location.size() <= 100 &&
        (data.price is int || data.price is float) && data.price > 0 && data.price <= 10000 &&
        data.quantity is int && data.quantity >= 1 && data.quantity <= 50 &&
        data.status in ['reserved', 'cancelled'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    match /test/connection {
      allow get: if isValidId('connection');
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && request.auth.uid == adminId;
      allow list, create, update, delete: if false;
    }

    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if request.time != null;

      allow create: if isSignedIn() &&
        isValidId(productId) &&
        isValidProduct(incoming()) &&
        incoming().id == productId &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isSignedIn() &&
        isValidId(productId) &&
        isValidProduct(incoming()) &&
        (isAdmin() || existing().ownerId == request.auth.uid) &&
        incoming().id == existing().id &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'brand', 'category', 'description',
          'unit_size', 'gtin', 'dietary_tags', 'updatedAt'
        ]);

      allow delete: if isSignedIn() &&
        isValidId(productId) &&
        (isAdmin() || existing().ownerId == request.auth.uid);

      match /offers/{offerId} {
        allow get: if isValidId(productId) && isValidId(offerId);
        allow list: if request.time != null;

        allow create: if isSignedIn() &&
          isValidId(productId) &&
          isValidId(offerId) &&
          isValidOffer(incoming()) &&
          incoming().id == offerId &&
          incoming().productId == productId &&
          incoming().ownerId == request.auth.uid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          existsAfter(/databases/$(database)/documents/products/$(productId));

        allow update: if isSignedIn() &&
          isValidId(productId) &&
          isValidId(offerId) &&
          isValidOffer(incoming()) &&
          (isAdmin() || existing().ownerId == request.auth.uid) &&
          incoming().id == existing().id &&
          incoming().productId == existing().productId &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/products/$(productId)) &&
          (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'price', 'availability_status', 'stock_count', 'merchant_controls', 'updatedAt'
            ]) ||
            (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
              'merchant_name', 'location', 'price', 'currency',
              'availability_status', 'stock_count', 'merchant_controls', 'updatedAt'
            ]))
          );

        allow delete: if isSignedIn() &&
          isValidId(productId) &&
          isValidId(offerId) &&
          (isAdmin() || existing().ownerId == request.auth.uid);
      }
    }

    match /{path=**}/offers/{offerId} {
      allow list: if request.time != null;
    }

    match /reservations/{reservationId} {
      allow get: if isSignedIn() &&
        isValidId(reservationId) &&
        (existing().userId == request.auth.uid || isAdmin());

      allow list: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
        isValidId(reservationId) &&
        isValidReservation(incoming()) &&
        incoming().id == reservationId &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'reserved' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/products/$(incoming().productId)/offers/$(incoming().offerId));

      allow update: if isSignedIn() &&
        isValidId(reservationId) &&
        isValidReservation(incoming()) &&
        (isAdmin() || (existing().userId == request.auth.uid && existing().status != 'cancelled')) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        incoming().productId == existing().productId &&
        incoming().offerId == existing().offerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(reservationId) && isAdmin();
    }
  }
}
